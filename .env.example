# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
API_KEY=dev-secret-key
# Frontend → backend (Next.js reads NEXT_PUBLIC_* in frontend-next/.env.local)
# On Windows use 127.0.0.1 to avoid ~2s IPv6 localhost resolution delay
API_BASE_URL=http://127.0.0.1:8000
# PROTECT_METRICS=true
# DISABLE_OPENAPI_IN_PRODUCTION=true
# QUOTA_CHAT_PER_MONTH=0
# QUOTA_EVAL_PER_MONTH=0

# Stripe billing (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...

# PostgreSQL platform state (optional — JSON fallback if unset)
# DATABASE_URL=postgresql://agent:changeme@localhost:5432/agent
# POSTGRES_PASSWORD=changeme-prod-pg

# Enterprise SAML (optional — OIDC preferred for MVP)
# SAML_ENABLED=false
# SAML_IDP_METADATA_URL=
# SAML_SP_ENTITY_ID=
# SAML_ACS_URL=

# GitHub App / private repos
# GITHUB_TOKEN=ghp_...
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# OIDC SSO (optional)
# OIDC_ALLOW_UNSIGNED=false
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# OIDC_POST_LOGIN_REDIRECT=http://localhost:3000
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# LLM / Provider
# ---------------------------------------------------------------------------
# Allowed values: groq, ollama
LLM_PROVIDER=groq

# Your API key for Groq (required when LLM_PROVIDER=groq)
GROQ_API_KEY=

# Model for FINALIZE (8b instant is fast; 70b is higher quality but slower)
LLM_MODEL=llama-3.1-8b-instant

# Base URL for a local Ollama instance (if applicable)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Webhook
# ---------------------------------------------------------------------------
# Secret key used to verify incoming GitHub webhooks (required in production)
GITHUB_WEBHOOK_SECRET=
# Alias supported: WEBHOOK_SECRET=
# Set ENVIRONMENT=production to enforce webhook secret at startup
ENVIRONMENT=development
WEBHOOK_SECRET_REQUIRED=false

# ---------------------------------------------------------------------------
# Redis (jobs + tool cache; graceful fallback if unavailable)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# Persistence paths (must match app/config.py defaults)
# ---------------------------------------------------------------------------
DATA_PATH=./data
CHROMA_DB_PATH=./data/chroma_db
BM25_INDEX_PATH=./bm25_index
GRAPH_STORE_PATH=./data/graph_store
REPOS_PATH=./data/repos

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Maximum allowed repository size in megabytes for ingestion
MAX_REPO_SIZE_MB=500

# ---------------------------------------------------------------------------
# Embedding & retrieval
# ---------------------------------------------------------------------------
# The HuggingFace sentence-transformers model to use for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# The cross-encoder model used for reranking search results
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Constant K used in Reciprocal Rank Fusion
RRF_K=60

# Enable query expansion using the LLM
QUERY_EXPANSION_ENABLED=true

# Minimum confidence threshold to consider an answer valid
CONFIDENCE_GATE_THRESHOLD=4.0

# ---------------------------------------------------------------------------
# Semantic cache
# ---------------------------------------------------------------------------
# Enable semantic caching for repeated queries
SEMANTIC_CACHE_ENABLED=true

# Threshold for semantic cache similarity match
CACHE_SIMILARITY_THRESHOLD=0.95

# Time-to-live (in days) for cache entries
SEMANTIC_CACHE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Agent loop tuning
# ---------------------------------------------------------------------------
EXACT_QUESTION_CACHE_TTL_S=300
FINALIZE_MAX_TOKENS=700
DECIDE_MAX_TOKENS=8
HYBRID_SEARCH_TOP_K=20
RERANK_TOP_N=8
LLM_RATE_LIMIT_MAX_BACKOFF_S=60
GROQ_LLM_RATE_LIMIT_ATTEMPTS=3
GROQ_TTFT_TIMEOUT_S=15
GROQ_FINALIZE_TIMEOUT_S=45
RETRIEVAL_FAST_PATH_SCORE=0.25
GRAPH_CONTEXT_MAX_CHARS=2000

# Claim verification
CLAIM_EMBED_BORDERLINE_MARGIN=0.08
CITED_TEXT_MAX_CHARS=4000

# Rate limits (per org, sliding window)
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_MINUTE=3
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Ingestion file filter
MAX_FILE_SIZE_BYTES=1048576
BINARY_SNIFF_BYTES=8192
MAX_MEAN_LINE_LENGTH=300
MAX_REPLACEMENT_CHAR_RATIO=0.05

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
# Maximum number of iterations the agent can run before giving up
MAX_AGENT_ITERATIONS=5

# Maximum execution time (in seconds) for a single agent session
AGENT_MAX_SECONDS=90

# ---------------------------------------------------------------------------
# Graph
# ---------------------------------------------------------------------------
# Maximum number of nodes to store in the graph
MAX_GRAPH_NODES=10000

# Timeout (in seconds) for cycle detection algorithms on the graph
CYCLE_DETECTION_TIMEOUT_S=10

# ---------------------------------------------------------------------------
# Ingestion queue
# ---------------------------------------------------------------------------
# Time-to-live (in seconds) for pending ingestions before timeout
INGEST_PENDING_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# External calls
# ---------------------------------------------------------------------------
# Timeout (in seconds) for searching web documents
SEARCH_WEB_DOCS_TIMEOUT_S=5

# ---------------------------------------------------------------------------
# Context compression
# ---------------------------------------------------------------------------
# Similarity threshold for filtering/compressing context chunks
CONTEXT_COMPRESSION_THRESHOLD=0.6

# Eval / regression
EVAL_MAX_QUESTIONS=0
EVAL_SKIP_AGENT_PROBE=true
# EVAL_VERSION=
EVAL_QUESTION_DELAY_S=4

# SSE streaming
SSE_QUEUE_MAXSIZE=64
SSE_QUEUE_GET_TIMEOUT_S=1.0
SSE_STREAM_IDLE_TIMEOUT_S=300

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Logging level (e.g. DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
