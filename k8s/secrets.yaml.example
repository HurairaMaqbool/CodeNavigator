# Copy to secrets.yaml and fill before apply. Do not commit real secrets.
apiVersion: v1
kind: Secret
metadata:
  name: agent-secrets
  namespace: codebase-agent
type: Opaque
stringData:
  API_KEY: changeme-use-24-char-minimum-key
  GROQ_API_KEY: gsk_changeme
  GITHUB_WEBHOOK_SECRET: changeme
  REDIS_PASSWORD: changeme-redis
  REDIS_URL: redis://:changeme-redis@redis:6379/0
  SESSION_SECRET: changeme-session-secret-32chars
  STRIPE_SECRET_KEY: ""
  STRIPE_WEBHOOK_SECRET: ""
